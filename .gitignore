# Secrets — never commit
.env
.env.*
!.env.example

# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# Vercel
.vercel

# SQLx offline query cache is committed on purpose (.sqlx/) so CI can build
# without a live database. Local scratch is not.
.sqlx-tmp/

# Tooling
.DS_Store
Thumbs.db
*.log
coverage/

# Next.js generated
next-env.d.ts

# Locally-installed agent skills (npx skills add) — not app code
.agents/

# Locally-installed skills via `npx skills add` (not app code)
.claude/skills/schema/
.claude/skills/seo-audit/
.claude/skills/programmatic-seo/
skills-lock.json
