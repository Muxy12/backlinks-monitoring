# Backlio — environment template (§43)
# Copy to .env and fill in. NEVER commit a filled-in .env.
# Deployed environments read these from Vercel / Fly secrets, not from a file.

# ─── Core ──────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | preview | production
RUST_LOG=info,api=debug,worker=debug,crawler=debug
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# ─── Database (§6) ─────────────────────────────────────────────────────────
# DATABASE_URL        pooled endpoint  (-pooler in the host) — used by the API
# DATABASE_DIRECT_URL direct endpoint                        — worker + migrations
# Local Docker Postgres: both point at the same local instance.
DATABASE_URL=postgres://backlio:backlio@localhost:5432/backlio
DATABASE_DIRECT_URL=postgres://backlio:backlio@localhost:5432/backlio
DB_MAX_CONNECTIONS=8
# Blank = auto: 0 when the host contains "-pooler", else 100. See docs/adr/0005.
DB_STATEMENT_CACHE_CAPACITY=

# Optional: enables the Neon pooler integration test. Skipped when unset.
NEON_TEST_POOLED_URL=

# ─── Auth (§19) ────────────────────────────────────────────────────────────
SESSION_SECRET=                     # 32+ random bytes, base64. Generate per environment.
SESSION_TTL_HOURS=720
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# ─── Crawler (§25–§28) ─────────────────────────────────────────────────────
CRAWLER_USER_AGENT=Backlio/1.0 (+https://backlio.app/bot)
CRAWLER_MAX_CONCURRENCY=50
CRAWLER_MAX_PER_DOMAIN=2
CRAWLER_DOMAIN_MIN_INTERVAL_MS=1000
CRAWLER_REQUEST_TIMEOUT_SECS=15
CRAWLER_TOTAL_TIMEOUT_SECS=30
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_RESPONSE_BYTES=2097152
CRAWLER_RESPECT_ROBOTS=true

# ─── Worker / scheduler (§10, §11) ─────────────────────────────────────────
WORKER_ID=                          # blank → hostname-pid-uuid
WORKER_CONCURRENCY=16
WORKER_POLL_INTERVAL_MS=1000
WORKER_JOB_LEASE_SECS=900
SCHEDULER_BATCH_SIZE=500
SCHEDULER_SECRET=                   # shared secret for POST /internal/scheduler/tick

# ─── Billing (§39) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_PLUS=

# ─── Email (§37) ───────────────────────────────────────────────────────────
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=alerts@backlio.app

# ─── Frontend (Vercel) ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
